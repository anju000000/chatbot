# --- アプリ共通 ---
APP_ENV=development
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# --- LLM プロバイダ切替: ollama | bedrock | openai_compatible ---
LLM_PROVIDER=ollama

# --- Ollama（ローカル）---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Docker 内からホストの Ollama へ: http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
# OLLAMA_TEMPERATURE=0.7

# --- OpenAI 互換 API（任意）---
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=

# --- AWS Bedrock（P4 以降）---
# AWS_REGION=ap-northeast-1
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- Langfuse（P3 以降）---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- DB（任意）---
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/chatbot

# --- ベクトルストア（RAG 時）---
# VECTOR_STORE_PROVIDER=chroma
# CHROMA_PERSIST_DIR=./data/chroma

# --- Streamlit ---
STREAMLIT_API_BASE_URL=http://localhost:8000
